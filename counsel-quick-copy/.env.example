# MySQL 또는 TiDB
DATABASE_URL=mysql://counsel:counsel@localhost:3306/counsel
# 로그인 쿠키 서명용 (32자 이상 랜덤 문자열)
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000

# 이미지 저장소: S3 호환 스토리지. S3_BUCKET 이 비어 있으면 로컬 디렉터리(UPLOAD_DIR)에 저장 (개발용)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=.data/uploads
